# Copy to a secret-managed environment; do not commit real credentials.
DB_URL=jdbc:mariadb://localhost:3306/ra_system
DB_USERNAME=ra_system
DB_PASSWORD=replace-ra-database-password
MARIADB_RA_ROOT_PASSWORD=replace-ra-root-password
CA_DB_URL=jdbc:mariadb://localhost:3307/ca_system
CA_DB_USERNAME=ca_system
CA_DB_PASSWORD=replace-ca-database-password
MARIADB_CA_ROOT_PASSWORD=replace-ca-root-password
JWT_SECRET=replace-with-at-least-32-random-bytes
BOOTSTRAP_ADMIN_USERNAME=ca-admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_PASSWORD=change-this-strong-password
ALLOWED_ORIGINS=https://ra.example.org
CA_BASE_URL=http://localhost:8081/api/v1
# CA listener mTLS; production must enable TLS and set the trust/key stores.
CA_TLS_ENABLED=false
CA_TLS_KEYSTORE=
CA_TLS_KEYSTORE_PASSWORD=
CA_TLS_TRUSTSTORE=
CA_TLS_TRUSTSTORE_PASSWORD=
CA_MTLS_REQUIRED=true
CA_ALLOWED_CLIENT_SUBJECTS=CN=ra-client,O=Example
# HSM provider config file path, HSM key/certificate alias, and secret-managed PIN.
HSM_PKCS11_CONFIG=
HSM_CA_KEY_ALIAS=
HSM_PIN=
CA_SIGNATURE_HASH=SHA256
DEFAULT_CERTIFICATE_VALIDITY_DAYS=365
CRL_VALIDITY_HOURS=24
# For RA outbound mTLS to CA, configure the corresponding client and CA trust stores.
CA_CLIENT_KEYSTORE=
CA_CLIENT_KEYSTORE_PASSWORD=
CA_TRUSTSTORE=
CA_TRUSTSTORE_PASSWORD=
